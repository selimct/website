<?xml version="1.0" encoding="utf-8"?>
<style xmlns="http://purl.org/net/xbiblio/csl" version="1.0" class="in-text" default-locale="en-GB">
  <info>
    <title>Minimal numeric style</title>
    <id>http://www.zotero.org/styles/minimal-numeric-template</id>
    <link href="http://www.zotero.org/styles/minimal-numeric-template" rel="self"/>
    <updated>2026-08-05T00:00:00+00:00</updated>
  </info>
  <citation collapse="citation-number">
    <layout prefix="[" suffix="]" delimiter=", "><text variable="citation-number"/></layout>
  </citation>
  <bibliography et-al-min="6" et-al-use-first="3">
    <layout suffix=".">
      <text variable="citation-number" suffix=". "/>
      <names variable="author" suffix=". "><name initialize-with=". " and="text"/></names>
      <text variable="title" suffix=". "/>
      <text variable="container-title" font-style="italic" suffix=" "/>
      <text variable="volume" font-weight="bold"/>
      <text variable="page" prefix=", "/>
      <date variable="issued" prefix=" (" suffix=")"><date-part name="year"/></date>
      <text variable="DOI" prefix=". https://doi.org/"/>
    </layout>
  </bibliography>
</style>
